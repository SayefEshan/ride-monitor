# Reference for the server-side environment file.
#
# `scripts/bootstrap.sh` writes this for you — you only need this template if
# you are setting a server up by hand:
#
#   cd ~/ride-monitor
#   cp .env.production.example .env    # the name must be exactly .env
#   chmod 600 .env && nano .env
#
# It must be called `.env`: Compose reads only that filename when substituting
# ${APP_DOMAIN} in docker-compose.yml, so any other name leaves Caddy without
# a domain and TLS never comes up.

# The domain Caddy issues a TLS certificate for. Its A record must already
# point at this server.
APP_DOMAIN=ride.assist.bd

# Supabase project settings -> API
# (Being retired: the self-hosted Postgres below replaces the cloud project.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Self-hosted database (compose service `db`) -----------------------------
# Generate each secret with: openssl rand -hex 24

# Superuser password for the postgres container itself.
POSTGRES_PASSWORD=generate-me

# The two roles the app connects as; migrate.sh attaches these passwords.
APP_DB_PASSWORD=generate-me
ADMIN_DB_PASSWORD=generate-me

# Embed the SAME passwords literally — env_file values are not interpolated.
DATABASE_URL=postgres://app_user:the-app-db-password@db:5432/ride_monitor
DATABASE_URL_ADMIN=postgres://app_admin:the-admin-db-password@db:5432/ride_monitor

# Signs the session cookie. Rotating it logs every user out.
# Generate with: openssl rand -base64 48
AUTH_SECRET=generate-me

# Where receipt photos live inside the app container (a named volume).
RECEIPTS_DIR=/data/receipts
