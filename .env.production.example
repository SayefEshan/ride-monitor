# Copy to .env.production ON THE SERVER and fill in. Never commit the real one.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# The two NEXT_PUBLIC_ values are also needed at image build time (they are
# inlined into the browser bundle), so they are set as GitHub secrets too.
# The service-role key is only ever read here, at run time.

# The domain Caddy issues a TLS certificate for. Its A record must already
# point at this server.
APP_DOMAIN=ride.example.com

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
