# Local development: copy to .env.local.
# On the server: copy to .env — Compose reads only that exact filename when it
# substitutes ${APP_DOMAIN}, so any other name leaves Caddy with an empty domain
# and TLS never comes up, without an obvious error.
#
# Fill the Supabase values in from Dashboard -> Project Settings -> API.

# Server only; unused in local dev. The domain Caddy issues the certificate for.
APP_DOMAIN=ride.example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS, so it must never be exposed to the browser or
# committed. Used for onboarding and for creating driver logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
